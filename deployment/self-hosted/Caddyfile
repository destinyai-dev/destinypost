{
	email {$ACME_EMAIL}
	admin off
}

{$DESTINYPOST_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2GB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:5000
}
